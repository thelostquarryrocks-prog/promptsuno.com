{
  "name": "promptsuno",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:build": "python3 -I scripts/catalog/build_catalog.py data/catalog/v1/suno-style-matrix-v1.json data/catalog/v1/suno-style-catalog-v1.json data/catalog/v2/",
    "catalog:validate": "python3 -I scripts/catalog/validate_catalog.py data/catalog/v2/",
    "engine": "tsx --tsconfig tsconfig.json scripts/engine/inspect.ts",
    "idea": "tsx --tsconfig tsconfig.json scripts/engine/idea.ts",
    "writer": "tsx --tsconfig tsconfig.json scripts/writer/run.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
