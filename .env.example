# Copy to .env.local and fill in. Never commit real values.
# Variables are added here as each service is wired up.

# Supabase (added with auth + database)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only

# OpenAI (added with generation)
# OPENAI_API_KEY=                   # server-only
# Optional overrides. Defaults are in src/lib/writer/config.ts.
# OPENAI_MODEL_ANONYMOUS=gpt-5.6-luna
# OPENAI_MODEL_FREE=gpt-5.6-luna
# OPENAI_MODEL_PRO=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low       # or "off" for models that reject it

# Stripe (added with billing)
# STRIPE_SECRET_KEY=                # server-only
# STRIPE_WEBHOOK_SECRET=            # server-only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
